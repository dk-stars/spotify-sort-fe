server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # HTML entry point — never cache so Cloudflare always fetches the latest
  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
    add_header Pragma "no-cache";
    expires -1;
    try_files $uri =404;
  }

  # Runtime env config — never cache (contains injected env vars)
  location = /env-config.js {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
    add_header Pragma "no-cache";
    expires -1;
    try_files $uri =404;
  }

  # Hashed assets (Vite adds content hash to filenames) — cache forever
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    expires 1y;
    try_files $uri =404;
  }

  # Other static files (images, fonts, icons)
  location ~* \.(svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot)$ {
    add_header Cache-Control "public, max-age=86400";
    expires 1d;
    try_files $uri =404;
  }

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
